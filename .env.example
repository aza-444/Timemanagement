# Telegram Bot Token (BotFather'dan olingan token)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Administrator Telegram ID larining vergul bilan ajratilgan ro'yxati (masalan: 12345678,87654321)
ADMIN_IDS=12345678

# Ma'lumotlar bazasi URL (Standart: SQLite WAL async)
DB_URL=sqlite+aiosqlite:///expenses.db

# Kunlik eslatma vaqti (Format: HH:MM)
DEFAULT_REMINDER_TIME=21:00
