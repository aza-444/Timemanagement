[Unit]
Description=Telegram Expense Tracker Bot (Aiogram 3.x)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aza
WorkingDirectory=/home/aza/Desktop/TIMEMANAGEMENT
ExecStart=/home/aza/Desktop/TIMEMANAGEMENT/venv/bin/python bot.py
Restart=always
RestartSec=5
StandardOutput=append:/home/aza/Desktop/TIMEMANAGEMENT/bot.log
StandardError=append:/home/aza/Desktop/TIMEMANAGEMENT/bot.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
